{
  "name": "catalyst-music",
  "description": "Catalyst Music Telegram Mini App and music player.",
  "repository": "https://github.com/anmoldeep182012-ai/Catalyst-web-player",
  "logo": "https://files.catbox.moe/a9n3sd.jpg",
  "keywords": [
    "telegram",
    "music",
    "bot",
    "webapp",
    "webplayer",
    "go"
  ],
  "stack": "container",
  "env": {
    "BOT_COMMANDS_ENABLED": { "description": "False when Python Catalyst handles normal bot commands; Mini App verification callbacks remain enabled.", "required": false, "value": "false" },
    "API_ID": {
      "description": "Your Telegram API ID.",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API hash.",
      "required": true
    },
    "TOKEN": {
      "description": "Your Telegram bot token.",
      "required": true
    },
    "MONGO_URI": {
      "description": "Your MongoDB connection string.",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID. Required by the application.",
      "required": true
    },
    "LOGGER_ID": {
      "description": "The Telegram group or channel ID used for application logs.",
      "required": true
    },
    "MAX_FILE_SIZE": {
      "description": "The maximum file size for downloads (in bytes).",
      "required": false,
      "value": "524288000"
    },
    "API_URL": {
      "description": "API URL for external services.",
      "required": false,
      "value": "https://api.onegrab.fun"
    },
    "API_KEY": {
      "description": "API key for the configured external media service, if required.",
      "required": false
    },
    "DEFAULT_SERVICE": {
      "description": "Default music download service (e.g., youtube).",
      "required": false,
      "value": "youtube"
    },
    "DOWNLOADS_DIR": {
      "description": "Directory to store downloads.",
      "required": false
    },
    "DB_NAME": {
      "description": "Name of the MongoDB database.",
      "required": false,
      "value": "CatalystWebApp"
    },
    "PROXY": {
      "description": "Proxy URL for the bot.",
      "required": false
    },
    "COOKIES_URL": {
      "description": "URL to a cookies file for yt-dlp. (via batbin.me)",
      "required": false
    },
    "SUPPORT_GROUP": {
      "description": "Link to the support group.",
      "required": false,
      "value": "https://t.me/CatalystxSupport"
    },
    "SUPPORT_CHANNEL": {
      "description": "Link to the support channel.",
      "required": false,
      "value": "https://t.me/CatalystxSupport"
    },
    "SONG_DURATION_LIMIT": {
      "description": "The maximum duration of a song in seconds.",
      "required": false,
      "value": "3600"
    },
    "DEVS": {
      "description": "A space-separated list of developer user IDs.",
      "required": false
    },
    "PORT": {
      "description": "Port for the Web Player HTTP server.",
      "required": false,
      "value": "6060"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
